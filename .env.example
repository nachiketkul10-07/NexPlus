# PulseOps Environment Variables Template
# Copy this file to .env for local development. Never commit real credentials.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-this-in-production-use-a-secure-random-secret-key-32bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL)
POSTGRES_USER=pulseops
POSTGRES_PASSWORD=pulseops_dev_pass
POSTGRES_DB=pulseops_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://pulseops:pulseops_dev_pass@localhost:5432/pulseops_db

# Async & Cache Configuration (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_TELEMETRY_PER_MINUTE=600

# AI Assistant Configuration (Groq Provider)
AI_ENABLED=true
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_SECONDS=20
AI_MAX_CONTEXT_CHARS=12000
AI_MAX_LOG_ENTRIES=20
AI_MAX_METRIC_POINTS=30

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
