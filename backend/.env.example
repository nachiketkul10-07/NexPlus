# NexPulse Backend Environment Variables Template
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-this-in-production-use-a-secure-random-secret-key-32bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+asyncpg://pulseops:pulseops_dev_pass@localhost:5432/pulseops_db
REDIS_URL=redis://localhost:6379/0

# AI Assistant Configuration (Groq Provider)
AI_ENABLED=true
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_SECONDS=20
AI_MAX_CONTEXT_CHARS=12000
AI_MAX_LOG_ENTRIES=20
AI_MAX_METRIC_POINTS=30
