# Copy to .env.production, restrict file permissions, and never commit the real file.
NEXPULSE_DOMAIN=nexpulse.example.com
SECRET_KEY=REPLACE_WITH_AT_LEAST_40_RANDOM_CHARACTERS
POSTGRES_ADMIN_USER=nexpulse_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_DATABASE_ADMIN_PASSWORD
POSTGRES_DB=nexpulse
APP_DB_USER=nexpulse_app
APP_DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_UNIQUE_APPLICATION_PASSWORD
DATABASE_URL=postgresql+asyncpg://nexpulse_app:URL_ENCODED_APPLICATION_PASSWORD@postgres:5432/nexpulse
REDIS_PASSWORD=REPLACE_WITH_A_DIFFERENT_UNIQUE_PASSWORD
REDIS_URL=redis://:URL_ENCODED_REDIS_PASSWORD@redis:6379/0
ALLOWED_ORIGINS=https://nexpulse.example.com
TRUSTED_HOSTS=nexpulse.example.com
AI_API_KEY=
